#!/bin/sh
set -eu

if [ "${DOCGOV_REPAIR_ACTIVE:-}" = "1" ]; then
  exit 2
fi
root=$(git rev-parse --show-toplevel)
cd "$root"
state=$(git rev-parse --git-path docgov/config.json)
if [ -f "$state" ]; then
  # Installed background mode never waits for a model at commit time.
  # The installation wrapper registers work and stages exact verified outputs.
  exit 0
fi
docgov_bin=${DOCGOV_BIN:-}
if [ -z "$docgov_bin" ]; then
  docgov_bin=$(git config --get docgov.binary || true)
fi
if [ -n "$docgov_bin" ]; then
  exec "$docgov_bin" --root "$root" repair --json
fi
if [ -x .venv/bin/python ]; then
  exec .venv/bin/python -m docgov --root "$root" repair --json
fi
exec python3 -m docgov --root "$root" repair --json
